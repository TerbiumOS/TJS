{
	"name": "@terbiumos/tjs",
	"version": "1.0.0",
	"description": "Terbium.js - Universal SDK for building apps that work in Terbium and browsers",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"prepublishOnly": "npm run build",
		"format": "biome format --write ."
	},
	"keywords": [
		"terbium",
		"terbiumos",
		"webos",
		"cloud",
		"sdk"
	],
	"author": "TerbiumOS Development",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/terbiumos/tjs.git"
	},
	"bugs": {
		"url": "https://github.com/terbiumos/tjs/issues"
	},
	"homepage": "https://github.com/terbiumos/tjs#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/node": "^20.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.0.0",
		"vitest": "^1.0.0"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	}
}
